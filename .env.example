# New workspace API. Local dev: /backend (Vite proxy); hosting: full HTTPS API URL.
# Empty = configuration error. No fallback to the old FCC API or synthetic data.
VITE_CAREBRIDGE_API_URL=

# Legacy FCC screens only (not used by the new application entrypoint).
VITE_API_BASE_URL=

# Local proxy destination (not a secret).
VITE_DEV_PROXY_TARGET=https://uwv0zhujxf.execute-api.ap-northeast-2.amazonaws.com

# Optional dev WebSocket override. Otherwise discovered from backend /health at startup.
VITE_DEV_WS_TARGET=
# Must match the backend FrontendOrigin; used only by the local WebSocket proxy.
VITE_DEV_FRONTEND_ORIGIN=https://develop.db2l4u9y804jp.amplifyapp.com
